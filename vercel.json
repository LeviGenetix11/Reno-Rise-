{
  "trailingSlash": true,
  "redirects": [
    { "source": "/blog/best-flooring-for-basement-toronto.html", "destination": "/blog/best-flooring-basement-toronto.html", "permanent": true },
    { "source": "/blog/do-you-need-a-subfloor-in-a-finished-basement.html", "destination": "/blog/basement-subfloor-finished-basement.html", "permanent": true },
    { "source": "/blog/hardwood-flooring-in-basement.html", "destination": "/blog/hardwood-flooring-basement.html", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:path*/index.html", "destination": "/:path*/", "permanent": true },
    { "source": "/services/sump-pump-installation/", "destination": "/services/sump-pump/", "permanent": true },
    { "source": "/services/backwater-valve-installation/", "destination": "/services/backwater-valve/", "permanent": true },
    { "source": "/renorise-forms/:path*", "destination": "/", "permanent": false },
    { "source": "/renorise-dashboard/:path*", "destination": "/", "permanent": false },
    { "source": "/renorise-shared/:path*", "destination": "/", "permanent": false },
    { "source": "/renorise-voice/:path*", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
