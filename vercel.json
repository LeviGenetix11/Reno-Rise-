{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*/",
      "permanent": true
    },
    {
      "source": "/services/sump-pump-installation/",
      "destination": "/services/sump-pump/",
      "permanent": true
    },
    {
      "source": "/services/backwater-valve-installation/",
      "destination": "/services/backwater-valve/",
      "permanent": true
    },
    {
      "source": "/renorise-forms/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/renorise-dashboard/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/renorise-shared/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/renorise-voice/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
